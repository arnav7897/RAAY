DATABASE_URL=postgresql://postgres:postgres@localhost:5433/raay
POSTGRES_PORT=5433
RAW_CACHE_DIR=/app/data/raw
RBI_USER_AGENT=RAAY/0.1 (+https://example.invalid/contact)
RBI_REQUEST_INTERVAL_SECONDS=1.0
RBI_DISCOVERY_KEYWORDS=microfinance,nbfc,know your customer,kyc
RBI_DISCOVERY_MAX_MATCHES_PER_SOURCE=20
RBI_SCHEDULER_TIMEZONE=Asia/Kolkata
RBI_SCHEDULER_RUN_ON_STARTUP=false
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.raay.local
AUTH0_CLIENT_ID=replace-me
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_ANSWER_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=120
EMBEDDING_MODEL=BAAI/bge-m3
